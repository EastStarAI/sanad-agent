#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CLIENT_SCRIPT="$REPO_ROOT/client/bin/sanad_client.dart"

if command -v fvm >/dev/null 2>&1; then
  exec fvm dart run "$CLIENT_SCRIPT" "$@"
elif [ -x "$REPO_ROOT/.fvm/flutter_sdk/bin/dart" ]; then
  exec "$REPO_ROOT/.fvm/flutter_sdk/bin/dart" run "$CLIENT_SCRIPT" "$@"
else
  exec dart run "$CLIENT_SCRIPT" "$@"
fi
