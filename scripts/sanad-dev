#!/usr/bin/env bash

set -euo pipefail

FVM_VERSION="4.1.2"
CALLER_DIR="$PWD"
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -h "$TARGET_FILE" ]; do
  DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
  TARGET_FILE="$(readlink "$TARGET_FILE")"
  [[ $TARGET_FILE != /* ]] && TARGET_FILE="$DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
WORKSPACE_ROOT="$(git -C "$CALLER_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$WORKSPACE_ROOT" ] && [ -f "$WORKSPACE_ROOT/sanad-agent/scripts/sanad_dev.dart" ]; then
  PROJECT_DIR="$WORKSPACE_ROOT/sanad-agent"
elif [ -n "$WORKSPACE_ROOT" ] && [ -f "$WORKSPACE_ROOT/scripts/sanad_dev.dart" ]; then
  PROJECT_DIR="$WORKSPACE_ROOT"
fi
RESOLVED_WRAPPER="$PROJECT_DIR/scripts/sanad-dev"
if [ "$TARGET_FILE" != "$RESOLVED_WRAPPER" ] && [ -x "$RESOLVED_WRAPPER" ]; then
  exec "$RESOLVED_WRAPPER" "$@"
fi
SCRIPT_DIR="$PROJECT_DIR/scripts"

stage() { printf '%-38s %s\n' "$1" "$2"; }
run_stage() {
  local name="$1" started status
  shift
  started=$SECONDS
  printf '\n==> %s\n' "$name"
  if "$@"; then
    stage "$name" "ready ($((SECONDS - started))s)"
    return 0
  else
    status=$?
    stage "$name" "failed ($((SECONDS - started))s)"
    return "$status"
  fi
}
sha256_file() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}';
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}';
  else echo 'A SHA-256 utility (shasum or sha256sum) is required.' >&2; return 1; fi
}

print_help() {
  cat <<'EOF'
Sanad development launcher

Usage:
  sanad-dev                         Show this help without changing the environment.
  sanad-dev install [--force]       Install/verify FVM, pinned Flutter, and the user command.
  sanad-dev setup [--force]         Ensure install, then resolve Contract, Agent, and Client packages.
  sanad-dev run [all|agent|client]  Ensure install/setup, then launch the requested runtime.
  sanad-dev <runtime-command>       Run status, logs, restart, reload, stop, doctor, or switch.

Official source run:
  sanad-dev run
EOF
}

ensure_posix_user_path() {
  local bin_root="$1" config marker='# sanad-dev user command'
  case ":$PATH:" in *":$bin_root:"*) return ;; esac
  case "${SHELL:-}" in
    */zsh) config="$HOME/.zshrc" ;;
    */bash) config="$HOME/.bashrc" ;;
    */fish)
      config="$HOME/.config/fish/config.fish"
      mkdir -p "$(dirname "$config")"
      if ! grep -Fq "$marker" "$config" 2>/dev/null; then
        printf '\n%s\nfish_add_path "%s"\n' "$marker" "$bin_root" >> "$config"
      fi
      echo "PATH configured for new terminals; run: fish_add_path \"$bin_root\""
      return
      ;;
    *) config="$HOME/.profile" ;;
  esac
  if ! grep -Fq "$marker" "$config" 2>/dev/null; then
    printf '\n%s\nexport PATH="%s:$PATH"\n' "$marker" "$bin_root" >> "$config"
  fi
  echo "PATH configured for new terminals; open a new terminal or source $config."
}

_install_fvm() {
  command -v curl >/dev/null 2>&1 || { echo 'curl is required to install FVM.' >&2; return 1; }
  command -v tar >/dev/null 2>&1 || { echo 'tar is required to install FVM.' >&2; return 1; }
  local os arch platform checksum archive url install_root bin_root
  case "$(uname -s)" in Darwin) os=macos ;; Linux) os=linux ;; *) echo 'Unsupported POSIX platform.' >&2; return 1 ;; esac
  case "$(uname -m)" in x86_64|amd64) arch=x64 ;; arm64|aarch64) arch=arm64 ;; riscv64) arch=riscv64 ;; *) echo "Unsupported architecture: $(uname -m)" >&2; return 1 ;; esac
  platform="$os-$arch"
  case "$platform" in
    macos-arm64) checksum=0b2a146986c51f06331f135f0bdf2a202eb57f55d7edd420c9078e8520e4c033 ;;
    macos-x64) checksum=7bbfcb6883ea67ce532163704f5625eba7ecf340084be707cde71a28fefff1d8 ;;
    linux-arm64) checksum=1a53c57842b20c812404044c9efa16065a24e67cbb296c2f64ae339d145b974c ;;
    linux-x64) checksum=12b0656688450972750cb714fc5e44ed2dbdd6b1c6813ba6ba6fb71841c17fe4 ;;
    linux-riscv64) checksum=0d7dabe49fe20e06a68ce57bfdd7dbd6bb7cac6165fd3d89c8ad1c5c42810803 ;;
    *) echo "No verified FVM artifact for $platform." >&2; return 1 ;;
  esac
  install_root="${XDG_DATA_HOME:-$HOME/.local/share}/sanad-dev/fvm"
  bin_root="${XDG_BIN_HOME:-$HOME/.local/bin}"
  archive="$(mktemp "${TMPDIR:-/tmp}/sanad-fvm.XXXXXX.tar.gz")"
  url="https://github.com/leoafarias/fvm/releases/download/$FVM_VERSION/fvm-$FVM_VERSION-$platform.tar.gz"
  curl -fL --progress-bar "$url" -o "$archive"
  [ "$(sha256_file "$archive")" = "$checksum" ] || { echo 'FVM archive checksum verification failed.' >&2; return 1; }
  rm -rf "$install_root"
  mkdir -p "$install_root" "$bin_root"
  tar -xzf "$archive" -C "$install_root"
  rm -f "$archive"
  FVM_BIN="$(find "$install_root" -type f -name fvm | head -1)"
  [ -n "$FVM_BIN" ] || { echo 'The verified FVM archive did not contain an executable.' >&2; return 1; }
  chmod +x "$FVM_BIN"
  ln -sfn "$FVM_BIN" "$bin_root/fvm"
  FVM_BIN="$bin_root/fvm"
  ensure_posix_user_path "$bin_root"
  export PATH="$bin_root:$PATH"
}

ensure_fvm() {
  if command -v fvm >/dev/null 2>&1; then
    FVM_BIN="$(command -v fvm)"
    return
  fi
  run_stage "Installing verified FVM $FVM_VERSION" _install_fvm
}

_install_flutter() {
  "$FVM_BIN" install "$1"
}

_flutter_ready() {
  cd "$PROJECT_DIR"
  "$FVM_BIN" spawn "$1" --version >/dev/null 2>&1
}

ensure_flutter() {
  local flutter_pin
  flutter_pin="$(sed -n 's/.*"flutter"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PROJECT_DIR/.fvmrc")"
  [ -n "$flutter_pin" ] || { echo 'Could not read the pinned Flutter version.' >&2; return 1; }
  _flutter_ready "$flutter_pin" && return
  run_stage "Installing Flutter $flutter_pin" _install_flutter "$flutter_pin"
  _flutter_ready "$flutter_pin" || { echo "Flutter $flutter_pin is unavailable after installation." >&2; return 1; }
}

_write_shim() {
  local shim="$1" expected="$2"
  ln -sfn "$expected" "$shim"
  ensure_posix_user_path "$(dirname "$shim")"
}

install_shim() {
  local force="$1" allow_existing="$2" bin_root shim existing expected
  bin_root="${XDG_BIN_HOME:-$HOME/.local/bin}"
  shim="$bin_root/sanad-dev"
  mkdir -p "$bin_root"
  expected="$PROJECT_DIR/scripts/sanad-dev"
  if [ -e "$shim" ] || [ -L "$shim" ]; then
    existing="$(readlink "$shim" 2>/dev/null || printf 'non-symlink')"
    if [ "$existing" = "$expected" ]; then return; fi
    if [ "$allow_existing" = true ]; then return; fi
    if [ "$force" != true ]; then
      echo "sanad-dev already belongs to another checkout: $existing" >&2
      echo 'Re-run install --force to replace it.' >&2
      return 1
    fi
  fi
  run_stage 'Installing sanad-dev command' _write_shim "$shim" "$expected"
}

resolve_contract_dependencies() { cd "$PROJECT_DIR/release/contract" && "$FVM_BIN" dart pub get; }
resolve_agent_dependencies() { cd "$PROJECT_DIR/agent" && "$FVM_BIN" dart pub get; }
resolve_client_dependencies() { cd "$PROJECT_DIR/client" && "$FVM_BIN" flutter pub get; }

ensure_dependencies() {
  local flutter_pin stamp_root fingerprint stamp packages_ready=false
  flutter_pin="$(sed -n 's/.*"flutter"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PROJECT_DIR/.fvmrc")"
  stamp_root="$PROJECT_DIR/.dart_tool/sanad-dev"
  mkdir -p "$stamp_root"
  fingerprint="$(printf '%s:%s:%s:%s' "$flutter_pin" "$(sha256_file "$PROJECT_DIR/release/contract/pubspec.lock")" "$(sha256_file "$PROJECT_DIR/agent/pubspec.lock")" "$(sha256_file "$PROJECT_DIR/client/pubspec.lock")" | { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi; } | awk '{print $1}')"
  stamp="$stamp_root/setup.stamp"
  [ -f "$PROJECT_DIR/release/contract/.dart_tool/package_config.json" ] && [ -f "$PROJECT_DIR/agent/.dart_tool/package_config.json" ] && [ -f "$PROJECT_DIR/client/.dart_tool/package_config.json" ] && packages_ready=true
  if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$fingerprint" ] && [ "$packages_ready" = true ]; then return; fi
  run_stage 'Resolving Release Contract dependencies' resolve_contract_dependencies
  run_stage 'Resolving Agent dependencies' resolve_agent_dependencies
  run_stage 'Resolving Client dependencies' resolve_client_dependencies
  printf '%s' "$fingerprint" > "$stamp"
}

run_install() {
  local force="$1" allow_existing_shim="$2"
  ensure_fvm
  ensure_flutter
  install_shim "$force" "$allow_existing_shim"
}

run_setup() {
  local force="$1" allow_existing_shim="$2"
  run_install "$force" "$allow_existing_shim"
  ensure_dependencies
}

require_runtime_cli() {
  command -v fvm >/dev/null 2>&1 || { echo 'FVM is not installed. Run: sanad-dev install' >&2; return 1; }
  FVM_BIN="$(command -v fvm)"
  local flutter_pin
  flutter_pin="$(sed -n 's/.*"flutter"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PROJECT_DIR/.fvmrc")"
  [ -n "$flutter_pin" ] && _flutter_ready "$flutter_pin" || { echo 'Pinned Flutter is not installed. Run: sanad-dev install' >&2; return 1; }
  [ -f "$PROJECT_DIR/client/.dart_tool/package_config.json" ] || { echo 'Project packages are not ready. Run: sanad-dev setup' >&2; return 1; }
}

main() {
  local command="${1:-}" force=false
  case "$command" in ''|help|-h|--help) print_help; return 0 ;; esac
  for arg in "$@"; do [ "$arg" = --force ] && force=true; done
  case "$command" in
    install)
      run_install "$force" false
      return 0
      ;;
    setup)
      run_setup "$force" false
      return 0
      ;;
    run)
      run_setup "$force" true
      ;;
    *)
      require_runtime_cli
      ;;
  esac
  local runtime_args=("$@")
  if [ "$command" = run ] && [ "$force" = true ]; then
    runtime_args=()
    for arg in "$@"; do [ "$arg" != --force ] && runtime_args+=("$arg"); done
  fi
  cd "$PROJECT_DIR/client"
  SANAD_DEV_CALLER_DIR="$CALLER_DIR" "$FVM_BIN" dart "$SCRIPT_DIR/sanad_dev.dart" "${runtime_args[@]}"
}

main "$@"
